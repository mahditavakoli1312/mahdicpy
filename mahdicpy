# ─────────────────────────────── option parsing ─────────────────────────

class Opts:
    def __init__(self):
        self.serial = None
        self.record = None  # None, True (auto name) or a path
        self.gif = False
        self.watch = False
        self.dry = False
        self.smart = True
        self.profiles = []
        self.silent = False


def extract(args):
    """Pull mahdicpy's own flags out; everything else goes to scrcpy."""
    o, rest, i = Opts(), [], 0
    while i < len(args):
        a = args[i]
        nxt = args[i + 1] if i + 1 < len(args) else None
        if a in ("-s", "--serial") and nxt:
            o.serial, i = nxt, i + 1
        elif a.startswith("--serial="):
            o.serial = a.split("=", 1)[1]
        elif a == "--rec":
            o.record = True
        elif a.startswith("--rec="):
            o.record = a.split("=", 1)[1]
        elif a == "--gif":
            o.gif = True
            o.record = o.record or True
        elif a == "--watch":
            o.watch = True
        elif a in ("--dry-run", "--dry"):
            o.dry = True
        elif a == "--no-smart":
            o.smart = False
        elif a == "--silent":
            o.silent = True
        elif a == "--profile" and nxt:
            o.profiles.append(nxt)
            i += 1
        elif a.startswith("--profile="):
            o.profiles.append(a.split("=", 1)[1])
        elif a.startswith("@") and len(a) > 1:
            o.profiles.append(a[1:])
        elif a == "--":
            rest.extend(args[i + 1:])
            break
        else:
            rest.append(a)
        i += 1
    return o, rest


def smart_args(d):
    name = d.get("model") or d["serial"]
    args = [f"--window-title=mahdicpy · {name}"]
    if d["wifi"]:
        args += ["--max-size=1600", "--video-bit-rate=6M"]
    else:
        args += ["--stay-awake"]
    return args


def record_path(d):
    RECORD_DIR.mkdir(parents=True, exist_ok=True)
    name = re.sub(r"[^\w.-]+", "_", (d or {}).get("model") or "android")
    return RECORD_DIR / f"{name}_{datetime.now():%Y%m%d-%H%M%S}.mp4"


# ─────────────────────────────── running scrcpy ─────────────────────────

def scrcpy_env():
    env = dict(os.environ, ADB=ADB)
    if ICON.exists():
        env.setdefault("SCRCPY_ICON_PATH", str(ICON))
    return env


def run_scrcpy(argv, dry=False):
    cmd = [SCRCPY] + argv
    print(dim("  $ scrcpy " + shlex.join(argv)))
    if dry:
        return 0
    try:
        return subprocess.call(cmd, env=scrcpy_env())
    except KeyboardInterrupt:
        return 130
    except FileNotFoundError:
        die(f"scrcpy not found at {SCRCPY}")


def cmd_mirror(preset_name, args):
    cfg = load_config()
    preset = PRESETS[preset_name]
    o, rest = extract(args)

    # preset-specific positional arguments
    if preset_name == "cam" and rest and rest[0] in ("front", "back", "external"):
        preset = dict(preset, args=preset["args"] + [f"--camera-facing={rest.pop(0)}"])
    if preset_name == "desktop" and rest and re.match(r"^\d+x\d+(/\d+)?$|^/\d+$", rest[0]):
        preset = dict(preset, args=[f"--new-display={rest.pop(0)}"])
    if preset.get("record"):
        o.record = o.record or True

    d = None
    if preset.get("needs_adb", True):
        d = pick_device(o.serial, cfg)
        info(f"device: {label(d)}")

    argv = []
    if d:
        argv += ["--serial", d["serial"]]
        if o.smart and preset["smart"]:
            argv += smart_args(d)
    argv += cfg["defaults"]
    if d:
        argv += cfg["devices"].get(d["serial"], [])
    argv += preset["args"]
    for p in o.profiles:
        if p not in cfg["profiles"]:
            die(f"unknown profile '{p}'. Run: mahdicpy profile list")
        argv += cfg["profiles"][p]
    argv += rest

    out = None
    if o.record:
        out = Path(o.record) if o.record is not True else record_path(d)
        argv += [f"--record={out}"]
        if o.silent:
            argv += ["--no-window"]
        info(f"recording to {bold(out)} {dim('(close the window or Ctrl+C to stop)')}")

    rc = run_loop(argv, d, o)

    if out and out.exists() and not o.dry:
        ok(f"saved {bold(out)} ({out.stat().st_size / 1e6:.1f} MB)")
        if o.gif:
            make_gif(out)
    return rc


def run_loop(argv, d, o):
    while True:
        rc = run_scrcpy(argv, o.dry)
        if not o.watch or rc != EXIT_DISCONNECTED or d is None:
            return rc
        warn("device disconnected — waiting for it to come back (Ctrl+C to quit)…")
        try:
            while not any(x["serial"] == d["serial"] and x["state"] == "device"
                          for x in list_devices()):
                if d["wifi"]:
                    adb("connect", d["serial"], timeout=5)
                time.sleep(2)
        except KeyboardInterrupt:
            print()
            return 130
        ok("device is back, reconnecting")
        if o.record:  # never overwrite the previous take
            argv = [a for a in argv if not a.startswith("--record=")]
            argv.append(f"--record={record_path(d)}")


def make_gif(mp4):
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        warn("ffmpeg not installed, skipping GIF (brew install ffmpeg)")
        return
    gif = mp4.with_suffix(".gif")
    info("converting to GIF…")
    vf = "fps=15,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse"
    r = subprocess.run([ffmpeg, "-loglevel", "error", "-y", "-i", str(mp4), "-vf", vf,
                        str(gif)])
    if r.returncode == 0:
        ok(f"GIF: {bold(gif)} ({gif.stat().st_size / 1e6:.1f} MB)")


# ─────────────────────────────── commands ───────────────────────────────

def cmd_app(args):
    o, rest = extract(args)
    here = "--here" in rest
    if here:
        rest.remove("--here")
    if not rest or rest[0].startswith("-"):
        die("usage: mahdicpy app <name|package> [--here] [scrcpy options]")
    name = rest.pop(0)
    target = name if "." in name else f"?{name}"
    extra = [f"--start-app={target}"] + ([] if here else ["--new-display"])
    return cmd_mirror("mirror", _reinject(o) + extra + rest)


def _reinject(o):
    """Rebuild mahdicpy flags so helpers can call cmd_mirror again."""
    a = []
    if o.serial:
        a += ["-s", o.serial]
    if o.record is True:
        a += ["--rec"]
    elif o.record:
        a += [f"--rec={o.record}"]
    for flag, on in (("--gif", o.gif), ("--watch", o.watch), ("--dry-run", o.dry),
                     ("--no-smart", not o.smart), ("--silent", o.silent)):
        if on:
            a.append(flag)
    return a + [f"@{p}" for p in o.profiles]


def cmd_wifi(args):
    o, rest = extract(args)
    cfg = load_config()
    if rest and re.match(r"^[\d.]+(:\d+)?$", rest[0]):
        d = connect_wifi(rest.pop(0))
    else:
        usb = [x for x in list_devices() if x["state"] == "device" and not x["wifi"]]
        if o.serial:
            usb = [x for x in usb if x["serial"] == o.serial]
        if not usb:
            last = cfg.get("last_wifi")
            if not last:
                die("connect the phone via USB once (or run: mahdicpy pair)")
            info(f"reconnecting to {bold(last)}…")
            d = connect_wifi(last)
        else:
            src = usb[0] if len(usb) == 1 else pick_device(None, cfg)
            ip = device_ip(src["serial"])
            if not ip:
                die("phone is not on Wi-Fi")
            info(f"switching {label(src)} to Wi-Fi at {bold(ip)}…")
            adb("tcpip", "5555", serial=src["serial"])
            time.sleep(2)
            d = connect_wifi(f"{ip}:5555")
            ok("connected — you can unplug the cable now")
    o.serial = d["serial"]
    return cmd_mirror("mirror", _reinject(o) + rest)


def cmd_pair(args):
    print(bold("Wireless pairing (Android 11+)"))
    print(dim("  Phone: Settings › Developer options › Wireless debugging › "
              "Pair device with pairing code"))
    try:
        addr = args[0] if args else input(f"{cyan('?')} IP:port shown on the phone: ").strip()
        code = args[1] if len(args) > 1 else input(f"{cyan('?')} 6-digit pairing code: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    out = adb("pair", addr, code, timeout=30)
    if "Successfully paired" not in out:
        die(f"pairing failed: {out.strip() or 'no answer'}")
    ok("paired")
    ip = addr.split(":")[0]
    time.sleep(1)
    for line in adb("mdns", "services").splitlines():
        if "_adb-tls-connect" in line and ip in line:
            m = re.search(r"([\d.]+:\d+)", line)
            if m:
                d = connect_wifi(m.group(1))
                ok(f"connected to {label(d)}")
                return 0
    try:
        port = input(f"{cyan('?')} Port shown under 'IP address & Port' on the "
                     "Wireless debugging screen: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    d = connect_wifi(f"{ip}:{port}")
    ok(f"connected to {label(d)} — run: mahdicpy")
    return 0


def cmd_all(args):
    o, rest = extract(args)
    cfg = load_config()
    devs = [d for d in list_devices() if d["state"] == "device"]
    if not devs:
        die("no devices connected")
    sw, sh = screen_size()
    cols = min(len(devs), 4)
    rows = math.ceil(len(devs) / cols)
    w, h = sw // cols, (sh - 40) // rows
    info(f"launching {bold(len(devs))} devices in a {cols}×{rows} grid")
    procs = []
    for i, d in enumerate(devs):
        x, y = (i % cols) * w, 40 + (i // cols) * h
        argv = ["--serial", d["serial"]] + (smart_args(d) if o.smart else [])
        argv += [f"--window-x={x}", f"--window-y={y}",
                 f"--window-width={w}", f"--window-height={h - 30}"]
        argv += cfg["defaults"] + cfg["devices"].get(d["serial"], [])
        for p in o.profiles:
            argv += cfg["profiles"].get(p, [])
        argv += rest
        if o.record:
            argv += [f"--record={record_path(d)}"]
        print(dim("  $ scrcpy " + shlex.join(argv)))
        if not o.dry:
            procs.append(subprocess.Popen([SCRCPY] + argv, env=scrcpy_env()))
    try:
        for p in procs:
            p.wait()
    except KeyboardInterrupt:
        for p in procs:
            p.send_signal(signal.SIGINT)
        for p in procs:
            p.wait()
    return 0


def screen_size():
    try:
        out = subprocess.run(["system_profiler", "SPDisplaysDataType"],
                             capture_output=True, text=True, timeout=10).stdout
        m = re.search(r"UI Looks like: (\d+) x (\d+)", out) or \
            re.search(r"Resolution: (\d+) x (\d+)", out)
        if m:
            return int(m.group(1)), int(m.group(2))
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 1440, 900


def cmd_shot(args):
    o, rest = extract(args)
    d = pick_device(o.serial, load_config())
    SHOT_DIR.mkdir(parents=True, exist_ok=True)
    name = re.sub(r"[^\w.-]+", "_", d.get("model") or "android")
    path = SHOT_DIR / f"{name}_{datetime.now():%Y%m%d-%H%M%S}.png"
    data = subprocess.run([ADB, "-s", d["serial"], "exec-out", "screencap", "-p"],
                          capture_output=True).stdout
    if not data.startswith(b"\x89PNG"):
        die("screenshot failed (is the screen protected, e.g. a banking app?)")
    path.write_bytes(data)
    ok(f"screenshot: {bold(path)}")
    if "--no-clip" not in rest and sys.platform == "darwin":
        subprocess.run(["osascript", "-e",
                        f'set the clipboard to (read (POSIX file "{path}") as «class PNGf»)'],
                       capture_output=True)
        ok("copied to clipboard — paste it anywhere with ⌘V")
    if "--open" in rest:
        subprocess.run(["open", str(path)])
    return 0


def cmd_info(args):
    o, _ = extract(args)
    d = pick_device(o.serial, load_config())
    s = d["serial"]
    prop = lambda k: shell(s, f"getprop {k}")
    batt = shell(s, "dumpsys battery")
    level = int((re.search(r"level: (\d+)", batt) or [0, 0])[1])
    temp = int((re.search(r"temperature: (\d+)", batt) or [0, 0])[1]) / 10
    charging = (re.search(r"status: (\d+)", batt) or [0, "0"])[1] == "2"
    mem = re.search(r"MemTotal:\s+(\d+)", shell(s, "cat /proc/meminfo"))
    df = shell(s, "df -h /data").splitlines()
    storage = df[-1].split() if len(df) > 1 else []
    size = (re.search(r"(\d+x\d+)", shell(s, "wm size")) or [0, "?"])[1]
    dens = (re.search(r"(\d+)\s*$", shell(s, "wm density")) or [0, "?"])[1]

    bar_color = green if level > 50 else yellow if level > 20 else red
    bar = bar_color("▰" * (level // 10)) + dim("▱" * (10 - level // 10))
    rows = [
        ("Device", f"{prop('ro.product.manufacturer')} {prop('ro.product.model')}"),
        ("Android", f"{prop('ro.build.version.release')} (API {prop('ro.build.version.sdk')})"),
