#!/usr/bin/env python3
"""mahdicpy — a supercharged front-end for scrcpy.

Every unknown option is forwarded to scrcpy unchanged, so anything scrcpy can
do, mahdicpy can do too. See README.md for the full guide.
"""

import json
import math
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

VERSION = "1.0.0"
HERE = Path(os.path.realpath(__file__)).parent


def find_tool(name):
    """Bundled copy (next to mahdicpy or in vendor/) first, then PATH."""
    for d in (HERE, HERE / "vendor"):
        for n in (name, name + ".exe"):
            if (d / n).is_file():
                return str(d / n)
    return shutil.which(name) or name


def find_server_jar():
    candidates = [os.environ.get("SCRCPY_SERVER_PATH"), HERE / "scrcpy-server", HERE / "vendor" / "scrcpy-server",
                  Path(os.path.realpath(SCRCPY)).parent / "scrcpy-server"]
    candidates += [Path(p) / "share/scrcpy/scrcpy-server" for p in ("/opt/homebrew", "/usr/local", "/usr")]
    for c in candidates:
        if c and Path(c).is_file():
            return Path(c)
    return None


SCRCPY = find_tool("scrcpy")
ADB = find_tool("adb")
ICON = HERE / "mahdicpy.png"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "mahdicpy"
CONFIG_FILE = CONFIG_DIR / "config.json"
RECORD_DIR = Path.home() / "Movies" / "mahdicpy"
SHOT_DIR = Path.home() / "Pictures" / "mahdicpy"
EXIT_DISCONNECTED = 2  # scrcpy exit code when the device goes away

# ─────────────────────────────── styling ────────────────────────────────

_COLOR = bool(sys.stdout) and sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code):
    return (lambda s: f"\033[{code}m{s}\033[0m") if _COLOR else (lambda s: str(s))


bold, dim, red, green, yellow, blue, magenta, cyan = (
    _c("1"), _c("2"), _c("31"), _c("32"), _c("33"), _c("34"), _c("35"), _c("36"))


def gradient(text):
    if not _COLOR:
        return text
    stops = [(168, 85, 247), (99, 102, 241), (6, 182, 212), (16, 185, 129)]
    out, n = [], max(len(text) - 1, 1)
    for i, ch in enumerate(text):
        t = i / n * (len(stops) - 1)
        a, b = stops[int(t)], stops[min(int(t) + 1, len(stops) - 1)]
        f = t - int(t)
        r, g, bb = (int(a[k] + (b[k] - a[k]) * f) for k in range(3))
        out.append(f"\033[1;38;2;{r};{g};{bb}m{ch}")
    return "".join(out) + "\033[0m"


BANNER = r"""
  __  __   _   _  _ ___ ___ ___ _____   __
 |  \/  | /_\ | || |   \_ _/ __| _ \ \ / /
 | |\/| |/ _ \| __ | |) | | (__|  _/\ V /
 |_|  |_/_/ \_\_||_|___/___\___|_|   |_|
"""


def banner():
    for line in BANNER.strip("\n").splitlines():
        print(gradient(line))
    print(dim(f"  v{VERSION} · powered by scrcpy · Android mirroring on steroids\n"))


def info(msg):
    print(f"{cyan('›')} {msg}")


def ok(msg):
    print(f"{green('✔')} {msg}")


def warn(msg):
    print(f"{yellow('!')} {msg}", file=sys.stderr)


def die(msg, code=1):
    print(f"{red('✖')} {msg}", file=sys.stderr)
    sys.exit(code)


# ─────────────────────────────── config ─────────────────────────────────

def load_config():
    try:
        cfg = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        cfg = {}
    cfg.setdefault("defaults", [])
    cfg.setdefault("profiles", {})
    cfg.setdefault("devices", {})
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")


# ─────────────────────────────── adb helpers ────────────────────────────

def adb(*args, serial=None, check=False, timeout=30):
    cmd = [ADB] + (["-s", serial] if serial else []) + list(args)
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if check:
            die(f"adb timed out: {' '.join(args)}")
        return ""
    if check and p.returncode != 0:
        die(f"adb {' '.join(args)} failed: {(p.stderr or p.stdout).strip()}")
    return p.stdout


def shell(serial, command):
    return adb("shell", command, serial=serial).strip()


def list_devices():
    devices = []
    for line in adb("devices", "-l").splitlines()[1:]:
        parts = line.split()
        if len(parts) < 2:
            continue
        d = {"serial": parts[0], "state": parts[1]}
        for p in parts[2:]:
            if ":" in p:
                k, v = p.split(":", 1)
                d[k] = v.replace("_", " ")
        d["wifi"] = is_wifi(d["serial"])
        devices.append(d)
    return devices


def is_wifi(serial):
    return bool(re.match(r"^[\d.]+:\d+$", serial)) or serial.startswith("adb-")


def device_ip(serial):
    out = shell(serial, "ip -f inet addr show wlan0")
    m = re.search(r"inet ([\d.]+)/", out)
    if m:
        return m.group(1)
    m = re.search(r"src ([\d.]+)", shell(serial, "ip route"))
    return m.group(1) if m else None


def label(d):
    name = d.get("model") or d["serial"]
    link = "Wi-Fi" if d["wifi"] else "USB"
    return f"{bold(name)} {dim(d['serial'])} {cyan(link)}"


def pick_device(serial=None, cfg=None):
    """Resolve which device to use; connect over Wi-Fi if needed."""
    devs = list_devices()
    if serial:
        for d in devs:
            if d["serial"] == serial:
                return ensure_ready(d)
        if re.match(r"^[\d.]+(:\d+)?$", serial):
            target = serial if ":" in serial else f"{serial}:5555"
            return connect_wifi(target)
        die(f"device {serial} not found. Run: mahdicpy devices")

    ready = [d for d in devs if d["state"] == "device"]
    if not ready:
        for d in devs:
            ensure_ready(d)  # explains unauthorized / offline
        last = (cfg or {}).get("last_wifi")
        if last:
            info(f"no device attached, trying last Wi-Fi device {bold(last)}…")
            d = connect_wifi(last, fatal=False)
            if d:
                return d
        die("no device found. Plug in a phone with USB debugging enabled, "
            "or run: mahdicpy pair / mahdicpy wifi <ip>")
    if len(ready) == 1 or not sys.stdin.isatty():
        return ready[0]

    print(bold("Several devices are connected:"))
    for i, d in enumerate(ready, 1):
        print(f"  {magenta(i)}) {label(d)}")
    while True:
        try:
            choice = input(f"{cyan('?')} Pick one [1-{len(ready)}]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(130)
        if choice.isdigit() and 1 <= int(choice) <= len(ready):
            return ready[int(choice) - 1]


def ensure_ready(d):
    if d["state"] == "unauthorized":
        die(f"{d['serial']} is unauthorized — unlock the phone and accept "
            "the 'Allow USB debugging' prompt.")
    if d["state"] == "offline":
        die(f"{d['serial']} is offline — replug the cable or run: mahdicpy restart-adb")
    return d


def connect_wifi(target, fatal=True):
    if ":" not in target:
        target += ":5555"
    for _ in range(3):
        out = adb("connect", target, timeout=10)
        if "connected" in out and "cannot" not in out:
            for d in list_devices():
                if d["serial"] == target and d["state"] == "device":
                    cfg = load_config()
                    cfg["last_wifi"] = target
                    save_config(cfg)
                    return d
        time.sleep(1)
    if fatal:
        die(f"could not connect to {target}. Is the phone on the same network?")
    return None


