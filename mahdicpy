def main(argv):
    if argv and argv[0] in ("-v", "--version", "version"):
        print(f"mahdicpy {VERSION}")
        return subprocess.call([SCRCPY, "--version"])
    if not argv:
        return cmd_mirror("mirror", [])
    head, rest = argv[0], argv[1:]
    if head in COMMANDS:
        return COMMANDS[head](rest)
    if head in PRESETS:
        return cmd_mirror(head, rest)
    return cmd_mirror("mirror", argv)


